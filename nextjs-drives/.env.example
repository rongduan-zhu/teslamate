# JSON array defining both landing-page cards and allowed proxy destinations.
HOME_SERVER_SERVICES=[{"id":"teslamate","name":"TeslaMate Drives","description":"Drive history and metadata","upstreamUrl":"http://teslamate:4000/api","href":"/drives","accent":"#d1495b"},{"id":"example-api","name":"Example API","description":"An internal service","upstreamUrl":"http://example-api:8080","accent":"#235789"}]

# Toggl Track API token from Profile settings. The worker stays disabled when blank.
TOGGL_API_TOKEN=
TOGGL_SYNC_INTERVAL_SECONDS=172800
TOGGL_MIN_OVERLAP_SECONDS=60
CODEX_CLASSIFIER_MODEL=gpt-5.6-luna
